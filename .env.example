# =============================================================================
# Zero-Trust Document Access Gateway — variables d'environnement
# Copier en `.env` puis remplacer toutes les valeurs « change-me ».
# =============================================================================

# --- Infrastructure ----------------------------------------------------------
POSTGRES_URL=postgresql://ztg:ztg@base:5432/ztg
REDIS_URL=redis://file:6379
AI_ENGINE_URL=http://moteur-ia:8000

# --- Secrets -----------------------------------------------------------------
# JWT_SECRET  : signature des jetons (HS256).
# HASH_SALT   : sel du hachage des valeurs d'entités. Le CHANGER invalide
#               toutes les empreintes déjà stockées dans `entite_detectee`.
JWT_SECRET=change-me
HASH_SALT=change-me

# AES_KEY [M6.5, optionnel] — 32 octets en hexadécimal.
# Sans elle, la pseudonymisation reste déterministe mais devient irréversible :
# aucune correspondance n'est enregistrée dans `pseudonyme`.
#   python -c "import os; print(os.urandom(32).hex())"
AES_KEY=

# --- Moteur IA ---------------------------------------------------------------
# NER_BACKEND : camembert | spacy | presidio | aucun
#   camembert — meilleur sur les patronymes et toponymes ouest-africains,
#               mais l'image pèse ~2 Go (torch) ;
#   spacy     — nettement plus léger, rappel inférieur sur NOM_PERSONNE ;
#   presidio  — référence externe de comparaison pour l'évaluation ;
#   aucun     — règles seules, pour un démarrage rapide.
NER_BACKEND=camembert
NER_THRESHOLD=0.50
OCR_LANG=fra

# Construire une image sans torch : AVEC_CAMEMBERT=false + NER_BACKEND=spacy
AVEC_CAMEMBERT=true

# --- Stockage ----------------------------------------------------------------
# Ces identifiants ne sont distribués QU'aux services `passerelle` et
# `orchestrateur`. C'est la parade à la limite assumée du projet : le contrôle
# est applicatif, donc l'accès direct au stockage doit rester hors de portée
# des applications clientes.
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=documents
S3_REGION=us-east-1

# JSON du compte de service Google, sur une seule ligne.
GDRIVE_SERVICE_ACCOUNT_JSON=
GDRIVE_FOLDER_ID=

# --- Divers ------------------------------------------------------------------
LOCAL_ROOT=/data/local
WORKER_CONCURRENCE=4
SEED_PASSWORD=demo1234
